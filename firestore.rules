rules_version = '2';

// Drafted from the actual read/write patterns in this codebase (client SDK
// call sites in components/, app/, lib/) since no rules file previously
// existed in the repo — everything was running on whatever default is set
// in the Firebase console. Deploy with `firebase deploy --only firestore:rules`
// after reviewing against the Firebase console's current rules, and test
// with the Firestore emulator before rolling out to production.
//
// Server code using firebase-admin (everything under app/api/**, action/**)
// authenticates with a service account and always bypasses these rules —
// they only constrain the browser-facing client SDK.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────
    // Profile + onboarding + document metadata. `tokens` is the paid
    // resource and changes server-side only via firebase-admin: deductions
    // in the AI actions/routes (lib/tokensAdmin.ts), increases after a
    // verified payment (lib/paystackServer.ts). Client updates must leave
    // it untouched. `planId` similarly can only change server-side.
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.planId == 'free'
        && request.resource.data.tokens is number
        && request.resource.data.tokens <= 50;

      // diff/affectedKeys rather than field equality so updates on docs that
      // predate the tokens/planId fields (e.g. Google sign-ins created by an
      // older LoginModal) don't error out — touching either field is what's
      // forbidden.
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['planId', 'tokens']);

      // Account deletion in dashboard settings removes the user's own doc
      // client-side before deleting the auth user.
      allow delete: if isOwner(uid);

      // AI document-review results and mock-interview session history.
      // Only ever read/written by their owner from their own dashboard.
      match /reviews/{reviewId} {
        allow read, write: if isOwner(uid);
      }

      match /interview_sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      // Cached AI output (e.g. visa checklist) to avoid re-generating on
      // every visit. Owner-only, no cross-user sensitivity.
      match /cache/{cacheId} {
        allow read, write: if isOwner(uid);
      }

      // Created server-side only (app/api/notifications/broadcast uses
      // firebase-admin, bypassing these rules). Client may read its own,
      // mark items read, and dismiss (delete) them — NotificationBell does
      // both — but never create.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if false;
      }
    }

    // ── influencers/{uid} ────────────────────────────────────────────────
    // totalCommission is only ever adjusted server-side (withdrawal
    // request/reject routes, paystack-success) via firebase-admin
    // transactions, so client updates must leave it unchanged.
    match /influencers/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.totalCommission == 0;

      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalCommission']);

      allow delete: if false;
    }

    // ── promo_codes/{code} ───────────────────────────────────────────────
    // Created once at influencer signup; read by the checkout flow to
    // validate/apply a code. No client-side mutation after creation.
    match /promo_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.influencerId;
      allow update, delete: if false;
    }

    // ── payments/{id} ────────────────────────────────────────────────────
    // Written only by app/api/paystack-success (firebase-admin). Readable
    // by the payer and, separately, by the influencer credited on it.
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || resource.data.influencerId == request.auth.uid);
      allow write: if false;
    }

    // ── withdrawals/{id} ─────────────────────────────────────────────────
    // Written only by app/api/affiliate/withdrawals and
    // app/api/admin/withdrawals/reject (firebase-admin). Readable by the
    // influencer who requested it.
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && resource.data.influencerId == request.auth.uid;
      allow write: if false;
    }

    // ── visits/{id} ──────────────────────────────────────────────────────
    // Anonymous page-visit counter written by components/TrackVisit.tsx on
    // the public homepage (no auth exists at that point). Create-only, with
    // the exact shape logVisit sends, so the collection can't be used to
    // store or read anything else.
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['country', 'timestamp'])
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 60
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    // Deny anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
